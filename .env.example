# ============================================================
# ValiStock - Environment Variables
# Copy this file to .env and fill in the real values.
# NEVER commit the real .env file.
# ============================================================

# --- App ---
APP_ENV=development
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
TIMEZONE=America/Sao_Paulo

# --- Database (local Postgres for development) ---
DATABASE_URL=postgresql+psycopg2://valistock:valistock@localhost:5432/valistock

# --- Supabase (production database + infra) ---
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- CORS ---
FRONTEND_URL=http://localhost:5500
BACKEND_URL=http://localhost:8000

# --- Stripe (Fase 3) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ESSENCIAL=
STRIPE_PRICE_PROFISSIONAL=
STRIPE_PRICE_EMPRESA=
STRIPE_SUCCESS_URL=http://localhost:5500/planos?status=success
STRIPE_CANCEL_URL=http://localhost:5500/planos?status=cancel
